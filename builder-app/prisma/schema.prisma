generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Project {
  id           String       @id @default(cuid())
  name         String
  domain       String?
  legalEntity  String?
  regNumber    String?
  address      String?
  email        String?
  phone        String?
  governingLaw String?
  archetypeId  String?
  themeId      String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  pages        Page[]
  deployments  Deployment[]
}

model Page {
  id          String   @id @default(cuid())
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  route       String   @unique
  title       String?
  puckData    String   @default("{}") // JSON string
  data        String?  // JSON string mirror
  isPublished Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model Deployment {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  dokployAppId String?
  githubRepo   String?
  liveUrl      String?
  status       String   @default("pending")
  logs         String?  // JSON string
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
